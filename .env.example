# Copy to .env, keep it private, and replace this placeholder with a long random
# alphanumeric password (it is interpolated into a PostgreSQL connection URL).
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
# Used for native Bun development; Compose constructs its own DATABASE_URL.
DATABASE_URL=postgresql://ledger:replace-with-a-long-random-alphanumeric-password@localhost:5432/ledger
APP_PORT=3000
HOST=127.0.0.1
PORT=3000
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# Supply your provider key only in your private .env / deployment secret store.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# json_schema for strict structured outputs; json_object for compatible providers
# without strict schema support. Server-side validation always applies.
AI_RESPONSE_FORMAT=json_schema
AI_TIMEOUT_SECONDS=90
AI_MAX_CONCURRENCY=2
BUN_VERSION=1.4.2
